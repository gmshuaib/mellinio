# ==========================================
# E-Commerce Store Configuration
# ==========================================

# Checkout Mode: 'mock' (default simulated sandbox)
VITE_CHECKOUT_MODE=mock

# Live payments require server-side payment intent endpoints (e.g., Stripe, Razorpay).
# Client publishable key placeholder:
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Supabase Auth & Database (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
